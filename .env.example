# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Required: generate a private random value (at least 32 characters); never commit the actual secret.
JWT_SECRET=
ENABLE_DEMO_ACCOUNT=false
# Explicit development-only opt-in also requires DEMO_ACCOUNT_PASSWORD (at least 12 characters).
DEMO_ACCOUNT_PASSWORD=
API_REQUESTS_PER_MINUTE=120
AUTH_REQUESTS_PER_MINUTE=10

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/brisky

# Redis Configuration (BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Media binaries (optional — falls back to PATH, then bundled installer)
FFMPEG_PATH=
FFPROBE_PATH=

# Storage Configuration (Local scratch paths)
STORAGE_ROOT=./storage
UPLOAD_DIR=./storage/uploads
SCRATCH_DIR=./storage/scratch

# AI Keys & Models
# Remote inference is blocked until an explicit positive budget and per-model pricing are configured.
# Shared by API/worker only when they use the same durable ledger file.
AI_BUDGET_USD=0
AI_USAGE_LEDGER_PATH=./storage/usage/ai-attempts.jsonl
AI_MODEL_PRICING_JSON={"google-speech/gemini-3.8-flash-tts":{"reservationUsd":0.25,"inputUsdPerMillion":0.5,"outputUsdPerMillion":9},"google-speech/gemini-3.1-flash-lite":{"reservationUsd":0.05,"inputUsdPerMillion":0.5,"outputUsdPerMillion":1.5},"google-speech/gemini-3.8-flash-lite-tts":{"reservationUsd":0.25,"inputUsdPerMillion":0.5,"outputUsdPerMillion":6}}
AI_MAX_OUTPUT_TOKENS=4096
AI_REQUEST_TIMEOUT_MS=30000
SEARCH_INSPECTION_MAX_SECONDS=20
PEOPLE_CONVERSATION_MAX_CANDIDATES=3
SEARCH_INSPECTION_MAX_MB=25
SEARCH_CLOUD_SOURCE_MAX_MB=16
SEARCH_CLOUD_TOTAL_MB=32
SEARCH_DEADLINE_MS=30000
LOCAL_EMBEDDING_TIMEOUT_MS=60000
LOCAL_EMBEDDING_IDLE_MS=60000
LOCAL_EMBEDDING_ALLOW_DOWNLOAD=false
# Pricing JSON shape (fill in verified prices and a conservative per-attempt reservation):
# {"google/your-model":{"reservationUsd":0.10,"inputUsdPerMillion":0.0,"outputUsdPerMillion":0.0}}
# Reservations control admission, not the provider bill. Use a provider-side spending cap too.
AI_API_KEY=AQ.***-***
AI_API_KEYS=AQ.***-***,AQ.***-***,AQ.***-***
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.6-flash
AI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-001

# Scene detection
SCENE_THRESHOLD=0.3
SCENE_MAX_FRAMES=12
SCENE_MIN_SECONDS=0.5
TRANSCRIPT_CHUNK_SECONDS=150

# Speech transcription: whisper = local; ai = active AI_PROVIDER audio adapter.
# AI speech is included in controlled indexing reservations; no silent Whisper fallback.
# Windowed Whisper checkpoints apply only when whisper is selected.
TRANSCRIPTION_PROVIDER=ai
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_TASK=transcribe
WHISPER_LANGUAGE=
WHISPER_CPU_THREADS=4

# Vector Embeddings Provider (gemini = 3072 dims, local = 384 dims)
EMBEDDING_PROVIDER=gemini
# Optional comma-separated owner UUIDs selecting local embeddings for both index/query.
# Opt in only for a compatible corpus; other owners retain EMBEDDING_PROVIDER.
LOCAL_EMBEDDING_USER_IDS=
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Worker Process Decoupling (Factory Architecture Phase F0)
# Default is false: API server does not consume the indexing queue.
# Run `pnpm dev:worker` in a separate terminal for asynchronous indexing.
RUN_WORKER_IN_API=false

# Scratch quotas (Phase F4)
# Working-buffer cap for ranged slices / temp files (MB). Does NOT apply to full-file downloads.
WORKER_SCRATCH_MAX_MB=512
# Hard cap for a single full-file connector download (MB). Raise if you index huge masters.
WORKER_FULL_DOWNLOAD_MAX_MB=16384
# Clip range-transfer allowance, or complete-source size limit for connectors without seekable sessions.
# The lower of this and WORKER_FULL_DOWNLOAD_MAX_MB is used; local cached previews bypass downloads.
WORKER_CLIP_SOURCE_MAX_MB=256
# Stream local scene/audio preparation when the connector provides validated range sessions.
STREAM_INDEX_SOURCE=true
# Reuse small originals within a decoder session; 0 disables, maximum 64 MiB.
INDEX_SMALL_FILE_CACHE_MB=8
# Per indexing reader transfer allowance (MB); runtime default follows WORKER_FULL_DOWNLOAD_MAX_MB.
INDEX_RANGE_MAX_MB=16384
# Maximum reader lifetime for scene/audio preparation (milliseconds, at most one hour).
INDEX_RANGE_TIMEOUT_MS=900000
# Opt-in until real Whisper boundary accuracy is evaluated. Reuses one local model process per job.
WINDOWED_TRANSCRIPTION=false
WINDOWED_SCENE_PREPARATION=false
SCENE_WINDOW_SECONDS=60
SCENE_WINDOW_CONTEXT_SECONDS=2
SCENE_WINDOW_MAX_SCENES=1000
AUDIO_WINDOW_SECONDS=60
AUDIO_WINDOW_OVERLAP_SECONDS=2
# Local proxy cache ceiling (GB). Oldest-accessed proxies are evicted.
PROXY_CACHE_MAX_GB=10

# Google Drive Cloud Connector (Phase 4)
GOOGLE_CLIENT_ID=6445337***-***.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-***
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/connectors/google-drive/callback
# 32-byte AES-256 key formatted as 64 hex characters (e.g. openssl rand -hex 32)
CONNECTOR_ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY

# Ephemeral Media Factory Scheduler (Phase F5)
GLOBAL_MAX_ACTIVE_JOBS=2
DEFAULT_USER_SLOTS=1
INTERACTIVE_RESERVED_SLOTS=1
# Optional strict preparation/downstream partition. Both 0 disables it.
# For 2 preparation + 3 downstream slots, use global/user limits 5 and values 2/3.
FACTORY_INGEST_SLOTS=0
FACTORY_CONTINUATION_SLOTS=0

# Continuous Drive poller (API process only; workers skip this)
ENABLE_CONNECTOR_POLLING=true
CONNECTOR_POLL_INTERVAL_SEC=120

ENABLE_DEV_UPLOAD=false

AI_PROVIDER=google
AI_MAX_CONCURRENCY=2

# Dormant Meta adapter: leave AI_PROVIDER=google until separately approved live validation.
# Dedicated keys only; META_API_KEY falls back to MODEL_API_KEY, never to AI_API_KEY.
META_API_KEY=
META_MODEL=
META_FALLBACK_MODELS=
# Explicit modality-specific models are required for native video/audio operations.
# Verify IDs, modality support, rates and credit applicability before setting these.
META_VIDEO_MODEL=
META_VIDEO_FALLBACK_MODELS=
META_AUDIO_MODEL=
META_AUDIO_FALLBACK_MODELS=
META_MAX_OUTPUT_TOKENS=4096
# Video descriptions include reasoning tokens; bounded independently of chat.
META_VIDEO_MAX_OUTPUT_TOKENS=8192
META_REQUEST_TIMEOUT_MS=30000
META_MAX_MEDIA_BYTES=33554432
META_MAX_REQUEST_BYTES=50331648
META_TRANSCRIPT_CHUNK_SECONDS=90
# The existing embedding provider/model is preserved. No Meta embedding endpoint is assumed.
# Ledger pricing entries use meta/<exact-model-id> with verified rates/reservation.
# Conversational generation is opt-in; existing model/pricing/budget controls still apply.
# Use PORT=3001 when Next.js occupies port 3000. Never copy engine model keys into frontend.
SPACE_REPLIES_ENABLED=false

# Sponsor-hosted Meta model pilot. Select AI_PROVIDER=baseten explicitly.
# Keep this credential server-side; it is restricted to the exact hackathon ID.
BASETEN_AI_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
# Explicit media opt-in after validation; local Whisper remains the preferred transcription path.
BASETEN_MEDIA_ENABLED=false
BASETEN_MAX_OUTPUT_TOKENS=4096
BASETEN_MAX_REQUEST_BYTES=131072
# Serialized media payload, including base64/JSON. Separate from the text-only limit.
# Default 8 MiB; hard ceiling 100 MiB. Larger files need bounded windows or upload support.
BASETEN_MAX_MEDIA_REQUEST_BYTES=8388608
BASETEN_REQUEST_TIMEOUT_MS=45000
BASETEN_REASONING_EFFORT=high
GOOGLE_SAAS_REDIRECT_URI=http://localhost:3000/api/connectors/google-drive/callback
# Drive linking/folder selection/status are available without indexing workers.
# Enable sync only once the indexing provider/profile and workers are ready.
SAAS_DRIVE_SYNC_ENABLED=false
# Controlled manual indexing: explicit connector IDs, local speech/embeddings, <=32 MiB.
SAAS_DRIVE_SYNC_ACCOUNT_IDS=
INDEX_BUDGET_PLAN_ENABLED=false
INDEX_ALLOWED_CONNECTOR_ACCOUNT_IDS=
INDEX_PLAN_ATTEMPTS_PER_CALL=2
# Merge baseten/meta-models/muse-spark-open-1026 into AI_MODEL_PRICING_JSON:
# {"reservationUsd":0.25,"inputUsdPerMillion":1.25,"outputUsdPerMillion":4.25}
# Published standard rates are estimates; sponsor invoice/credit balance is unverified.
# Original video/audio require BASETEN_MEDIA_ENABLED=true; changing hosts does not migrate embeddings.

# Optional local face matching: run prepare_models.py and install the isolated runtime.
FACE_RECOGNITION_ENABLED=false
# Standalone workers may scan locally after an owner enables library matching.
# Set false to pause all archive face consumption without changing saved opt-ins.
FACE_ARCHIVE_WORKER_ENABLED=true
# FACE_PYTHON_BIN=/absolute/path/to/isolated/python

# Gemini speech, independent of AI_PROVIDER. Requires explicit google-speech model pricing.
VOICE_ENABLED=false
GEMINI_VOICE_API_KEY=
VOICE_TTS_MODEL=gemini-3.8-flash-tts
VOICE_TRANSCRIBE_MODEL=gemini-3.1-flash-lite
# Default voice; Settings may override with an allowed prebuilt voice.
VOICE_TTS_VOICE=Kore
VOICE_CACHE_DIR=storage/voice-cache
# Speech-only fallback when the preferred TTS model reaches a provider quota.
VOICE_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts

# Optional Gemini Live development path; excluded from the planned Meta-only profile.
# Requires google-live/gemini-3.8-live pricing: reservationUsd=1,
# inputUsdPerMillion=3, outputUsdPerMillion=12 (conservative audio rates).
VOICE_CONVERSATION_MODE=turn-based
VOICE_LIVE_MODEL=gemini-3.8-live
VOICE_LIVE_PUBLIC_URL=ws://localhost:3001/api/v1/saas-engine/voice/live
VOICE_LIVE_APP_ORIGIN=http://localhost:3000

# Meta speech profile: set VOICE_CONVERSATION_MODE=meta-mms after setup:mms.
# No Gemini speech fallback occurs in this profile. Existing Gemini values are retained.
# Voice coordination trial. Spark 1.3 remains available as an explicit alternative.
META_VOICE_MODEL=muse-wonder-1.0
# Merge meta/muse-wonder-1.0 pricing into AI_MODEL_PRICING_JSON:
# {"reservationUsd":0.25,"inputUsdPerMillion":4,"outputUsdPerMillion":20}
MMS_MODEL_DIR=storage/mms-models/eng
MMS_CPU_THREADS=4
# MMS_PYTHON_BIN=/absolute/path/to/isolated/python
# MMS_CACHE_DIR=storage/voice-cache/mms
# Add meta-asr/muse-voice-transcribe-1.0 pricing with reservationUsd=0.05,
# inputUsdPerMillion=0 and outputUsdPerMillion=0 (unused token placeholders).
# Actual transcription is audio-billed at $0.18/hour, not free/token billed.

# Strict event runtime: see docs/meta-only-runtime.md before enabling.
# Set embeddings to meta-local and disable both face flags when true.
META_ONLY_RUNTIME=false
META_EMBEDDING_MODEL_DIR=storage/meta-embeddings
META_EMBEDDING_THREADS=4
