# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/brisky
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=brisky

# Redis Configuration (BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Media binaries (optional — falls back to PATH, then bundled installer)
FFMPEG_PATH=
FFPROBE_PATH=

# Storage Configuration (Local scratch paths)
STORAGE_ROOT=./storage
UPLOAD_DIR=./storage/uploads
PROXY_DIR=./storage/proxies
THUMBNAIL_DIR=./storage/thumbnails
SCRATCH_DIR=./storage/scratch

# AI Keys & Models
GEMINI_API_KEY=AQ.Ab8RN6IxsigKam05utiyr8kDo3qf0ahApP-9fn_vpAZ7sFIfnA
GEMINI_API_KEYS=AQ.Ab8RN6IxsigKam05utiyr8kDo3qf0ahApP-9fn_vpAZ7sFIfnA,AQ.Ab8RN6I3UzDJAfrR-TQSn6X3bofjbKi__wzTDwYzt-Ns5FFJYQ,AIzaSyAyKxWka50PtNvXPVoSTsGrz_7IEZ1wmJI
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_INPUT_USD_PER_MILLION=0.15
GEMINI_OUTPUT_USD_PER_MILLION=0.60
GEMINI_EMBEDDING_USD_PER_MILLION=0.15

# Scene detection
SCENE_THRESHOLD=0.3
SCENE_MAX_FRAMES=12
SCENE_MIN_SECONDS=0.5
TRANSCRIPT_CHUNK_SECONDS=150
OPENAI_API_KEY=

# Local Speech Transcription (faster-whisper)
TRANSCRIPTION_PROVIDER=whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_TASK=transcribe
WHISPER_LANGUAGE=
WHISPER_CPU_THREADS=4

# Vector Embeddings Provider (gemini = 3072 dims, local = 384 dims)
EMBEDDING_PROVIDER=gemini
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Google Drive Cloud Connector (Phase 4)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/connectors/google-drive/callback
CONNECTOR_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
ENABLE_DEV_UPLOAD=false
VITE_ENABLE_DEV_UPLOAD=false
