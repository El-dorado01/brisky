{
  "name": "brisky",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm run dev:api",
    "dev:api": "pnpm --filter @brisky/api run dev",
    "dev:worker": "pnpm --filter @brisky/workers run dev",
    "dev:web": "pnpm --dir apps/web run dev",
    "build": "pnpm run build:api && pnpm run build:workers && pnpm run build:web",
    "build:api": "pnpm --filter @brisky/api run build",
    "build:web": "pnpm --dir apps/web run build",
    "build:workers": "pnpm --filter @brisky/workers run build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "setup:faces": "node scripts/setup-face-recognition.cjs",
    "setup:mms": "node scripts/setup-mms.cjs",
    "setup:meta-embeddings": "node scripts/setup-meta-embeddings.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED"
}
