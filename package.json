{
  "name": "brisky",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @brisky/api run dev",
    "dev:worker": "pnpm --filter @brisky/api run dev:worker",
    "dev:web": "pnpm --filter @brisky/web run dev",
    "build": "pnpm -r run build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED"
}
