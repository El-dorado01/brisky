# Next.js SaaS server only. Never prefix these with NEXT_PUBLIC_.
SAAS_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/brisky
SAAS_AUTH_SECRET=
# Required in production; must exactly match the browser origin, without trailing slash.
SAAS_APP_ORIGIN=http://localhost:3000
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Brisky
# Server-to-server URL. Run the engine on a different port from Next.js.
BRISKY_ENGINE_URL=http://127.0.0.1:3001
