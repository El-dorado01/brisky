# Media Factory worker image (compose profile "factory").
# The API and worker communicate strictly via Postgres + Redis (zero-shared-filesystem).
# Ephemeral scratch space is auto-purged inside /app/storage/scratch after each job.
FROM node:20-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg python3 python3-pip python3-venv \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json

RUN pnpm install --frozen-lockfile

COPY apps/api apps/api
COPY services/whisper-transcriber services/whisper-transcriber

RUN python3 -m pip install --no-cache-dir --break-system-packages -r services/whisper-transcriber/requirements.txt \
  || python3 -m pip install --no-cache-dir -r services/whisper-transcriber/requirements.txt

WORKDIR /app/apps/api
RUN pnpm build

ENV IS_WORKER=true
ENV RUN_WORKER_IN_API=false
ENV NODE_ENV=production

WORKDIR /app
CMD ["node", "apps/api/dist/worker.js"]
